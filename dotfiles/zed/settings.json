{
  "edit_predictions": {
    "open_ai_compatible_api": {
      "max_output_tokens": 1024,
      "model": "google/gemini-3.7-flash"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Frappé"
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "openrouter",
      "model": "google/gemini-3.7-flash"
    }
  },
  "base_keymap": "Emacs",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Zenburn Salad"
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."],
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true
      },
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  },
  "lsp": {
    "zls": {
      "binary": {
        "path": "/Users/gabri/Lang/zig/bin/zls"
      },
      "initialization_options": {
        "zig_exe_path": "/Users/gabri/Lang/zig/bin/zig"
      }
    },
    "ty": {
      "binary": {
        "path": ".venv/bin/ty"
      }
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": false,
    "show_other_hints": false
  }
}
